    subgraph Domain[Domain, no React]
        Workspace --> Diagram
        Diagram --> Link
        Diagram --> Placement --> NodeBounds
        Workspace --> ResourceRegistry --> Resource
        Resource -->|"component kind only"| ComponentDefinition
        ComponentDefinition -->|"one child Diagram, shared by every Placement"| Diagram
        Workspace -->|"diagramGraph, wouldCreateCycle"| DiagramGraph
        Diagram -->|"addPlacement asks Workspace.wouldCreateCycle"| Workspace
        Diagram -->|"resourceOf, Resource.handleIds: reads Resource live"| ResourceRegistry
        Diagram --> LinkRules
        Resource --> ResourceKinds
        LinkRules --> ResourceKinds
        ComponentDefinition -->|"attachPortOwner: its PortPlacement ids are nodes of the child Diagram"| Diagram
        Diagram -->|"portNodeHandleIds for a port id"| Port
        Navigator -->|"root; path of Placement ids via resourceOf; currentComponent"| Diagram
        History -->|"subscribes; capture, replaceContent"| Workspace
        History -->|reconcile after restore| Navigator
        Notifier --> Scheduler
        TimerScheduler -.implements.-> Scheduler
    end
    subgraph Persistence
        WorkspaceLoader --> Repository
