flowchart TD
    Main[main.tsx composition root]
    subgraph View[React view layer]
        AppProvider
        App
        DeleteFlow
        Breadcrumb
        CanvasView
        Sidebar["Sidebar: Details and Resources tabs"]
        Inspector
        ResourcesPanel["ResourcesPanel: all resource names"]
        ConfirmDialog
        TypesDialog
        ExceptionsDialog
        EnvironmentVariablesDialog
        CatalogDialog["CatalogDialog: shared list dialog"]
        IdListEditor["IdListEditor: chosen ids plus add select"]
        idListEdit["idListEdit: availableEntries"]
        RenameInput["RenameInput: RenameContext, useRenameController"]
        NotificationBar
        DiagramProjector
        PlacementNode["PlacementNode: component or other kind"]
        ResourcePicker
        resourceIcons["resourceIcons: ResourceIcon per ResourceKind"]
        LinkEdge
        PortList
        portEdit["portEdit: applyPortName"]
        Level[Level, inside CanvasView]
        RenameController
        useStore
        HistoryControls
        FocusGroup
        shortcutAction["shortcutAction, isTextInput"]
        clipboardShortcut["clipboardShortcut: clipboardAction, DUPLICATE_OFFSET"]
        pasteOffset["pasteOffset: offsetToCenter"]
    end
    subgraph Domain[Domain, no React]
        Workspace --> Diagram
        Diagram --> Link
        Diagram --> Placement --> NodeBounds
        Workspace --> ResourceRegistry --> Resource
        Resource -->|"component kind only"| ComponentDefinition
        ComponentDefinition -->|"one child Diagram, shared by every Placement"| Diagram
        Workspace -->|"diagramGraph, wouldCreateCycle"| DiagramGraph
        Diagram -->|"addPlacement asks Workspace.wouldCreateCycle"| Workspace
        Diagram -->|"resourceOf, Resource.handleIds: reads Resource live"| ResourceRegistry
        Diagram --> LinkRules
        Resource --> ResourceKinds
        LinkRules --> ResourceKinds
        Navigator -->|"root; path of Placement ids via resourceOf"| Diagram
        History -->|"subscribes; capture, replaceContent"| Workspace
        History -->|reconcile after restore| Navigator
        Notifier --> Scheduler
        TimerScheduler -.implements.-> Scheduler
    end
    subgraph Persistence
        WorkspaceLoader --> Repository
        WorkspaceLoader --> WorkspaceSerializer
        WorkspaceLoader -->|restore| Workspace
        WorkspaceSerializer -->|toSnapshot| Workspace
        WorkspaceSerializer -->|checkLink, handleIds, kindInvariantError| Domain
        WorkspaceSerializer -->|"schemaVersion 10; findCycle rejects Reference_Cycle"| DiagramGraph
        AutoSaver --> WorkspaceSerializer
        AutoSaver --> Repository
        LocalStorageRepository -.implements.-> Repository
    end
    Main -->|builds and starts| Persistence
    Main -->|creates| Domain
    Main -->|"services: workspace, navigator, history, notifier, scheduler"| AppProvider
    Main -->|creates and starts| History
    Main -->|shares one scheduler with| AutoSaver
    AppProvider --> App
    App -->|owns one instance| DeleteFlow
    App --> Breadcrumb
    Breadcrumb -->|trail| Navigator
    App --> CanvasView
    App --> Sidebar
    Sidebar -->|Details tab| Inspector
    Sidebar -->|Resources tab| ResourcesPanel
    ResourcesPanel -->|"resources.all; double-click renames via setName"| Workspace
    App --> ConfirmDialog
    App -->|Types button in header| TypesDialog
    App -->|Exceptions button in header| ExceptionsDialog
    App -->|Environment variables button in header| EnvironmentVariablesDialog
    App --> NotificationBar
    App -->|Undo and Redo buttons in header| HistoryControls
    HistoryControls -->|"undo, redo; useStore"| History
    HistoryControls -->|classifies key events| shortcutAction
    Inspector --> FocusGroup
    TypesDialog --> CatalogDialog
    ExceptionsDialog --> CatalogDialog
    EnvironmentVariablesDialog --> CatalogDialog
    CatalogDialog --> FocusGroup
    Inspector --> IdListEditor
    IdListEditor -->|availableEntries| idListEdit
    EnvironmentVariablesDialog --> FocusGroup
