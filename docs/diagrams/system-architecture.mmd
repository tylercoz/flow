    PlacementNode -->|"resize: placement(id).setBounds"| Diagram
    CanvasView -->|"onConnect: addLink with handle ids; errors to Notifier"| Diagram
    CanvasView -->|"drag: placement(id).setPosition"| Diagram
    CanvasView -->|"edgeTypes (module-level)"| LinkEdge
    LinkEdge -->|start; reads controller from| RenameController
    LinkEdge -->|renders| RenameInput
    PlacementNode -->|renders; reads controller from| RenameInput
