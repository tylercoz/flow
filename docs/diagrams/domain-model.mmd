classDiagram
    class ObservableStore {
        <<interface>>
        subscribe(listener)
        getVersion()
    }
    class ChangeSignal {
        subscribe(listener)
        getVersion()
        notify()
    }
    class Workspace {
        diagrams: list of TopDiagram, name and Diagram
        root: Diagram  %% the first diagram
        project: name, description, createdAt, updatedAt
        setProjectName(name)
        setProjectDescription(description)
        stampSaved(at)  %% silent, not an undo step
        addDiagram(name)
        renameDiagram(id, name)
        diagramImpact(id)
        removeDiagram(id)  %% LAST_DIAGRAM, MISSING_DIAGRAM
        load(snapshot)  %% replaces everything for a project swap
        types: list of DataType
        addType(name)
        renameType(id, name)
        removeType(id)
        exceptions: list of ExceptionType
        addException(name)
        renameException(id, name)
        exceptionUsage(id)
        removeException(id)
        environmentVariables: list of EnvironmentVariable
        addEnvironmentVariable(name)
        renameEnvironmentVariable(id, name)
        environmentVariableUsage(id)
        removeEnvironmentVariable(id)
        resources: ResourceRegistry
        allDiagrams() root plus each component's child Diagram
        componentResources()
        diagramGraph()
        wouldCreateCycle(target, resourceId)
        createPlacedResource(diagram, spec, position)
        setPorts(resourceId, field, ports)
        setResourceType(id, typeId)
        resourceImpact(id)
        removeResource(id)
        copy(diagram, nodeIds)
        paste(diagram, fragment, offset)
        moveIntoComponent(from, nodeIds, componentPlacementId, origin)
        toSnapshot(includeViewports)
        capture()
        replaceContent(snapshot)
        empty(ids)$
        restore(snapshot, ids)$
    }
    class DiagramContext {
        <<type>>
        ids: IdGenerator
        onChange()
        resources: ResourceLookup
        wouldCreateCycle(target, resourceId)
        pruneOrphans()
    }
    class Navigator {
        path: string[]  %% Placement ids
        root: Diagram  %% the top-level Diagram being viewed
        current: Diagram  %% last component's child Diagram, or root
        openDiagram(id)
        currentComponent: ComponentDefinition or null at the root
        trail() Resource[]
        open(placementId)
        navigateTo(index)
        reconcile()
    }
    class History {
        canUndo
        canRedo
        start()
        beginGroup()
        endGroup()
        undo()
        redo()
        reset()  %% clears both stacks after a project swap
    }
    class Restorable {
        <<interface>>
        capture()
        replaceContent(snapshot)
    }
    class Diagram {
        id
        viewport
        placements
        links
        placement(id)
        resourceOf(placementId)
        setViewport(v)
        addPlacement(resourceId, position)
        removePlacement(id)
        dropPlacementsOf(resourceId)
        dropLinksOnPorts(resourceId, field, keptIds)
        attachPortOwner(owner)  %% the component whose ports are nodes here
        dropLinksOfNodes(ids)
        countPlacementsOf(resourceId)
        addAll(placements, links)
        addLink(sourceId, targetId, sourcePortId, targetPortId)
        removeLink(id)
    }
    class ComponentDefinition {
        inputs: list of Port
        outputs: list of Port
        portPlacements: list of PortPlacement, every port has at least one
        portPlacement(id)
        portOf(nodeId) the Port a node shows
        portRole(nodeId) input, output or undefined
        setPortPlacementPosition(id, p)
        addPortPlacements(items)  %% one change; refuses an unknown port
        removePortPlacements(ids)  %% one change, drops their Links; refuses to leave a port with no node
        notes
        setPorts(field, ports)
        setNotes(notes)
        diagram: the one child Diagram, shared by every Placement
        exceptionIds: ExceptionType ids
        environmentVariableIds: EnvironmentVariable ids
        setExceptions(ids)
        dropException(id)
        setEnvironmentVariables(ids)
        dropEnvironmentVariable(id)
    }
    class NodeBounds {
        Position
        Size
        position
        size
        setPosition(p)
        setBounds(p, size)
    }
    class Placement {
        id
        resourceId
        position
        size
    }
    class DiagramGraph {
        <<module>>
        Diagram id to child Diagram ids
        reaches(graph, from, to)
        findCycle(graph)
    }
    class ResourceKinds {
        <<module>>
        RESOURCE_KINDS: typed per kind
        FIXED_HANDLES: source and target ids per non-component kind
        SIDE_PORTS
        handleIds(kind, ports, role)  %% a component's ids come from the given ports
        kindInvariantError(kind, typeId, hasDefinition)
        isResourceKind(v)
    }
    class LinkRules {
        <<module>>
        checkLink(sourceIds, sourcePortId, targetIds, targetPortId)
    }
    class Resource {
        id
        kind: ResourceKind
        name
        typeId: DataType id or null
        remote: web link, non-null only for repository
        format: free text, non-null only for artifact
        definition: ComponentDefinition, non-null only for component
        setName(name)
        setType(typeId)
        setRemote(remote)
        setFormat(format)
        handleIds(role)
    }
    class ResourceKind {
        <<type>>
        database, repository, artifact, user, input-object or component
    }
    class ResourceRegistry {
        all
        get(id)
        byKind(kind)
        add(resource)
        remove(id)
    }
    class Link {
        id
        name
        sourceId, targetId: Placement ids in the same Diagram, or PortPlacement ids of the component that owns it
        sourcePortId: output port id of the source Resource, or a side handle of an input port node
        targetPortId: input port id of the target Resource, or a side handle of an output port node
        waypoints: list of Position, bend points from source to target, empty for the automatic curve
        setWaypoints(points)
        setName(name)
    }
    class Port {
        <<module>>
        id
        name
        typeId: DataType id or null
        multiple, optional: flags on an input, omitted when false
        PortRole: input or output
        portNodeHandleIds(portRole, linkRole)  %% an input port node only starts Links, an output port node only ends them
    }
    class Catalog {
        all: list of entries
        has(id)
        add(name)
        rename(id, name)
        remove(id)
        replace(entries)
    }
    class DataType {
        <<type>>
        id
        name
    }
    class ExceptionType {
        <<type>>
        id
        name
    }
    class EnvironmentVariable {
        <<type>>
        id
        name
    }
    class Notifier {
        messages
        post(key, text, kind)
        clear(key)
    }
    class Scheduler {
        <<interface>>
        set(fn, ms)
        cancel(handle)
    }
    class TimerScheduler
    class PortPlacement {
        <<type>>
        id: a Link end, from the same IdGenerator as Placement ids
        portId: the Port it shows
        position: Position, or null for the default slot
    }
    class IdGenerator {
        <<interface>>
        next()
    }
    class UuidGenerator
    class DomainError {
        code: SELF_LINK, NOT_IN_DIAGRAM, INVALID_PORT, TYPE_IN_USE, MISSING_RESOURCE, INVALID_RESOURCE, TYPE_REQUIRED, NO_TYPES, UNKNOWN_TYPE, REFERENCE_CYCLE or NOT_A_COMPONENT
    }
    class Viewport {
        x
        y
        zoom
    }
    class WorkspaceSnapshot {
        <<plain data>>
        schemaVersion: 14
        project: ProjectDto, name, description, createdAt, updatedAt
        types: list of DataType
        exceptions: list of ExceptionType
        environmentVariables: list of EnvironmentVariable
        resources: list of ResourceDto, a component carries ComponentDto with its child DiagramDto and portNodes
        diagrams: list of NamedDiagramDto, at least one
    }
    class Fragment {
        <<plain data>>
        placements: list of PlacementDto
        links: list of LinkDto
    }
    Workspace ..> Fragment : copy returns, paste reads with fresh ids and throws MISSING_RESOURCE first
    Workspace ..> Diagram : paste calls addAll
    ChangeSignal ..|> ObservableStore
    Workspace ..|> ObservableStore
    Navigator ..|> ObservableStore
    Notifier ..|> ObservableStore
    History ..|> ObservableStore
    Restorable --|> ObservableStore
    Workspace ..|> Restorable
    History --> ChangeSignal
    History --> Restorable : subscribes, capture, replaceContent
    History --> Navigator : reconcile after restore
    Workspace --> ChangeSignal
    Navigator --> ChangeSignal
    Notifier --> ChangeSignal
    Workspace ..> DiagramContext : builds one shared context
    Workspace ..> WorkspaceSnapshot : restore reads
    Diagram --> DiagramContext
    DiagramContext --> IdGenerator
    Diagram --> DomainError : throws
    Diagram *-- Viewport
    Workspace *-- Diagram : one or more top-level diagrams, each named
    Diagram *-- Link
    Diagram *-- Placement
    Diagram --> LinkRules : addLink calls checkLink
    Diagram --> ResourceRegistry : reads kind through ResourceLookup
    Placement *-- NodeBounds
    Placement ..> Resource : shares one, by resourceId
    Workspace *-- ResourceRegistry
    Workspace --> DomainError : TYPE_REQUIRED, NO_TYPES, UNKNOWN_TYPE
    Resource --> ResourceKind
    Resource --> ResourceKinds : typed or untyped
    LinkRules --> ResourceKinds : handle ids per kind
    Resource *-- ComponentDefinition : component kind only
    ComponentDefinition --> Diagram : one shared child, so Diagrams form a graph
    Workspace --> DiagramGraph : wouldCreateCycle
    Workspace --> DomainError : REFERENCE_CYCLE
    Diagram --> DomainError : REFERENCE_CYCLE
    Navigator --> DomainError : NOT_A_COMPONENT
    ResourceRegistry *-- Resource
    Resource ..> DataType : typed kinds refer by id
    Resource --> DomainError : INVALID_RESOURCE
    Workspace *-- Catalog : one each for types, exceptions, environment variables
    Catalog o-- DataType
    Catalog o-- ExceptionType
    ComponentDefinition ..> ExceptionType : can return, by id
    Catalog o-- EnvironmentVariable
    ComponentDefinition ..> EnvironmentVariable : relies on, by id
    ComponentDefinition *-- Port
    ComponentDefinition *-- PortPlacement : one or more per Port, so one input can feed many nodes
    PortPlacement ..> Port : shows by portId, holds no name or type
    ComponentDefinition --> IdGenerator : names new PortPlacements
    ComponentDefinition --> DomainError : LAST_PORT_NODE, INVALID_PORT
    ComponentDefinition ..> Diagram : attachPortOwner(this), so addLink accepts its port ids
    Diagram ..> Port : addLink resolves a port id with portNodeHandleIds
    Link ..> Port : joins an output to an input, by id
    Port ..> DataType : refers by id
    Workspace --> DomainError : TYPE_IN_USE
    Navigator --> Diagram : reads root, follows Placement ids via resourceOf
    Notifier --> Scheduler
    TimerScheduler ..|> Scheduler
    UuidGenerator ..|> IdGenerator
