classDiagram
    class ObservableStore {
        <<interface>>
        subscribe(listener)
        getVersion()
    }
    class ChangeSignal {
        subscribe(listener)
        getVersion()
        notify()
    }
    class Workspace {
        root: Diagram
        types: list of DataType
        addType(name)
        renameType(id, name)
        removeType(id)
        exceptions: list of ExceptionType
        addException(name)
        renameException(id, name)
        exceptionUsage(id)
        removeException(id)
        environmentVariables: list of EnvironmentVariable
        addEnvironmentVariable(name)
        renameEnvironmentVariable(id, name)
        environmentVariableUsage(id)
        removeEnvironmentVariable(id)
        resources: ResourceRegistry
        createPlacedResource(diagram, spec, position)
        setResourceType(id, typeId)
        resourceImpact(id)
        removeResource(id)
        copy(diagram, nodeIds)
        paste(diagram, fragment, offset)
        toSnapshot(includeViewports)
        capture()
        replaceContent(snapshot)
        empty(ids)$
        restore(snapshot, ids)$
    }
    class DiagramContext {
        <<type>>
        ids: IdGenerator
        onChange()
    }
    class Navigator {
        path: string[]
        current: Diagram
        trail()
        open(componentId)
        navigateTo(index)
        reconcile()
    }
    class History {
        canUndo
        canRedo
        start()
        beginGroup()
        endGroup()
        undo()
        redo()
    }
    class Restorable {
        <<interface>>
        capture()
        replaceContent(snapshot)
    }
    class Diagram {
        id
        viewport
        components
        placements
        links
        component(id)
        placement(id)
        positioned(id)
        setViewport(v)
        addComponent(position)
        addPlacement(resourceId, position)
        removePlacement(id)
        dropPlacementsOf(resourceId)
        countPlacementsOf(resourceId)
        addAll(components, placements, links)
        removeComponent(id)
        deletionImpact(id)
        setPorts(componentId, field, ports)
        addLink(sourceId, targetId, sourcePortId, targetPortId)
        removeLink(id)
    }
    class Component {
        id
        position
        size
        exceptionIds: ExceptionType ids
        environmentVariableIds: EnvironmentVariable ids
        details
        diagram
        setPosition(p)
        setBounds(p, size)
        setExceptions(ids)
        dropException(id)
        setEnvironmentVariables(ids)
        dropEnvironmentVariable(id)
    }
    class Positioned {
        <<interface>>
        id
        position
        size
        setPosition(p)
        setBounds(p, size)
    }
    class NodeBounds {
        position
        size
        setPosition(p)
        setBounds(p, size)
    }
    class Placement {
        id
        resourceId
    }
    class ResourceKinds {
        <<module>>
        RESOURCE_KINDS: typed, sourceIds, targetIds per kind
        DATABASE_PORTS
        SIDE_PORTS
        isResourceKind(v)
    }
    class LinkRules {
        <<module>>
        checkLink(source, sourcePortId, target, targetPortId)
    }
    class Resource {
        id
        kind: ResourceKind
        name
        typeId: DataType id or null
        setName(name)
        setType(typeId)
    }
    class ResourceKind {
        <<type>>
        database, artifact, user or input-object
    }
    class ResourceRegistry {
        all
        get(id)
        byKind(kind)
        add(resource)
        remove(id)
    }
    class Link {
        id
        sourceId
        targetId
        sourcePortId: output of source
        targetPortId: input of target
        details
    }
    class Details {
        name
        inputs: list of Port
        outputs: list of Port
        notes
        patch(partial)
        toJSON()
    }
    class Port {
        <<type>>
        id
        name
        typeId: DataType id or null
    }
    class DataType {
        <<type>>
        id
        name
    }
    class ExceptionType {
        <<type>>
        id
        name
    }
    class EnvironmentVariable {
        <<type>>
        id
        name
    }
    class Describable {
        <<interface>>
        id
        details
    }
    class Notifier {
        messages
        post(key, text, kind)
        clear(key)
    }
    class Scheduler {
        <<interface>>
        set(fn, ms)
        cancel(handle)
    }
    class TimerScheduler
    class IdGenerator {
        <<interface>>
        next()
    }
    class UuidGenerator
    class DomainError {
        code: SELF_LINK, NOT_IN_DIAGRAM, INVALID_PORT, TYPE_IN_USE, MISSING_RESOURCE, INVALID_RESOURCE, TYPE_REQUIRED, NO_TYPES or UNKNOWN_TYPE
    }
    class Viewport {
        x
        y
        zoom
    }
    class WorkspaceSnapshot {
        <<plain data>>
        schemaVersion: 8
        types: list of DataType
        exceptions: list of ExceptionType
        environmentVariables: list of EnvironmentVariable
        resources: list of ResourceDto
        root: DiagramDto
    }
    class Fragment {
        <<plain data>>
        components: list of ComponentDto
        placements: list of PlacementDto
        links: list of LinkDto
    }
    Workspace ..> Fragment : copy returns, paste reads with fresh ids and throws MISSING_RESOURCE first
    Workspace ..> Diagram : paste calls addAll
    ChangeSignal ..|> ObservableStore
    Workspace ..|> ObservableStore
    Navigator ..|> ObservableStore
    Notifier ..|> ObservableStore
    History ..|> ObservableStore
    Restorable --|> ObservableStore
    Workspace ..|> Restorable
    History --> ChangeSignal
    History --> Restorable : subscribes, capture, replaceContent
    History --> Navigator : reconcile after restore
    Workspace --> ChangeSignal
    Navigator --> ChangeSignal
    Notifier --> ChangeSignal
    Workspace ..> DiagramContext : builds one shared context
    Workspace ..> WorkspaceSnapshot : restore reads
    Diagram --> DiagramContext
    DiagramContext --> IdGenerator
    Diagram --> DomainError : throws
    Diagram *-- Viewport
    Workspace *-- Diagram : root
    Diagram *-- Component
    Diagram *-- Link
    Diagram *-- Placement
    Diagram --> LinkRules : addLink calls checkLink
    Diagram --> ResourceRegistry : reads kind through ResourceLookup
    Placement ..|> Positioned
    Component ..|> Positioned
    Component *-- NodeBounds
    Placement *-- NodeBounds
    Placement ..> Resource : shares one, by resourceId
    Workspace *-- ResourceRegistry
    Workspace --> DomainError : TYPE_REQUIRED, NO_TYPES, UNKNOWN_TYPE
    Resource --> ResourceKind
    Resource --> ResourceKinds : typed or untyped
    LinkRules --> ResourceKinds : handle ids per kind
    Component *-- Diagram : child
    ResourceRegistry *-- Resource
    Resource ..> DataType : typed kinds refer by id
    Resource --> DomainError : INVALID_RESOURCE
    Workspace *-- DataType
    Workspace *-- ExceptionType
    Component ..> ExceptionType : can return, by id
    Workspace *-- EnvironmentVariable
    Component ..> EnvironmentVariable : relies on, by id
    Details *-- Port
    Link ..> Port : joins an output to an input, by id
    Port ..> DataType : refers by id
    Workspace --> DomainError : TYPE_IN_USE
    Component *-- Details
    Link *-- Details
    Component ..|> Describable
    Link ..|> Describable
    Navigator --> Workspace : reads root
    Notifier --> Scheduler
    TimerScheduler ..|> Scheduler
    UuidGenerator ..|> IdGenerator
