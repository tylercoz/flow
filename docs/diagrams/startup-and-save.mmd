sequenceDiagram
    participant M as main.tsx
    participant R as Repository
    participant L as WorkspaceLoader
    participant S as WorkspaceSerializer
    participant W as Workspace
    participant A as AutoSaver
    participant N as Notifier
    participant H as History
    M->>L: load()
    L->>R: load()
    alt data found
        R-->>L: raw
        L->>S: deserialize(raw)
        Note over S: rejects schemaVersion other than 9, unknown resource or port, and Diagram cycles
        S-->>L: snapshot (plain data)
        L->>W: Workspace.restore(snapshot, ids)
    else none stored
        R-->>L: null
        L->>W: Workspace.empty(ids)
    else unreadable (load or deserialize throws PersistenceError)
        L->>N: post("load", persistent)
        L->>W: Workspace.empty(ids)
    end
    L-->>M: workspace, canSave
    M->>M: new Navigator(workspace)
    M->>H: new History(workspace, navigator), start()
    H->>W: subscribe, capture baseline
    Note over H: stacks live in memory only and are never saved
    opt canSave
        M->>A: start()
        A->>W: subscribe
    end
    W-->>H: change
    Note over H: records a step unless a text-input group is open, closed on blur
    W-->>A: change
    Note over H,A: undo and redo call W.replaceContent, which notifies once, so a restore is autosaved
    A->>A: debounce 500 ms, max wait 900 ms
    A->>S: serialize(workspace)
    A->>R: save(snapshot)
    alt save fails
        R-->>A: PersistenceError
        A->>N: post("save", changes not saved, persistent)
    else save succeeds
        A->>N: clear("save")
    end
    Note over A: pagehide calls flush() and saves immediately
